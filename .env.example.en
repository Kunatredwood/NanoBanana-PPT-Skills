##############################################################################
# PPT Generator Pro - Environment Variable Configuration
##############################################################################
#
# Usage:
#
# 1. Copy this file to .env
#    cp .env.example .env
#
# 2. Replace your-api-key-here with your actual API keys
#
# 3. The .env file will not be committed to Git (configured in .gitignore)
#
##############################################################################

##############################################################################
# .env File Location
##############################################################################
#
# This project supports smart .env file discovery, searching in this order:
#
# 1. Script directory (highest priority)
#    - Standalone mode: ./ppt-generator/.env
#    - Skill mode:      ~/.claude/skills/ppt-generator/.env
#
# 2. Parent directories up to project root
#    - Searches upward until a directory containing .git or .env is found
#    - Useful when the project is nested in a subdirectory
#
# 3. System environment variables (lowest priority)
#    - Used if none of the above locations contain the variables
#    - Not recommended; prefer using a .env file
#
# Recommended setup:
#
#   Standalone: place .env in the project root (same directory as generate_ppt.py)
#   As a Skill: place .env in ~/.claude/skills/ppt-generator/
#
##############################################################################

##############################################################################
# Required API Keys
##############################################################################

# Google AI API Key (required)
# Used for: generating PPT slide images with Nano Banana Pro (Gemini 3 Pro Image Preview)
# Get it at: https://aistudio.google.com/apikey
# Free tier: 15 requests/day
GEMINI_API_KEY=your-gemini-api-key-here

##############################################################################
# Optional API Keys (video features)
##############################################################################

# Kling AI Access Key (optional)
# Used for: generating transition videos between slides
# Get it at: https://klingai.com
# Note: omitting this still allows image generation; only video transitions are disabled
KLING_ACCESS_KEY=your-kling-access-key-here

# Kling AI Secret Key (optional)
# Used for: authentication alongside the Access Key
# Get it at: https://klingai.com
KLING_SECRET_KEY=your-kling-secret-key-here

##############################################################################
# Configuration Examples
##############################################################################
#
# Image generation only (recommended for beginners):
#   GEMINI_API_KEY=AIzaSy...  (your real key)
#   KLING_ACCESS_KEY=         (leave blank or remove)
#   KLING_SECRET_KEY=         (leave blank or remove)
#
# Full functionality (images + transition videos):
#   GEMINI_API_KEY=AIzaSy...
#   KLING_ACCESS_KEY=ak-...
#   KLING_SECRET_KEY=sk-...
#
##############################################################################

##############################################################################
# Security Reminders
##############################################################################
#
# Never commit the .env file to your Git repository!
# Never hardcode API keys in source code!
# Never share your API keys publicly!
#
# The .env file is listed in .gitignore and will not be tracked by Git.
# Use .env.example as a template to keep real keys safe.
# Periodically check for accidental key exposure: grep -r "AIzaSy\|ak-" .
#
##############################################################################

